        <!-- Right sidebar: notification -->
        <div id="right-sidebar" class="animated fadeInRight">
            <div class="vue-el" style="display: none">
                <div class="p-m">
                    <button type="button" id="sidebar-close" class="right-sidebar-toggle sidebar-button btn btn-default m-b-md" v-on:click.prevent v-on:click="close()">
                        <i class="pe pe-7s-close"></i>
                    </button>
                    <select class="form-control unread-type" v-model="filterValue" name="account" style="width: 120px; top: 20px; right: 20px; position: absolute">
                        <option value="" selected="selected">Tất cả</option>
                        <option value="(Chưa đọc)">(Chưa đọc)</option>
                        <option v-for="z in filters" v-bind:value="z">{{z}}</option>
                    </select>
                </div>

                <div v-if="confirmReload" class="confirmReload  btn-warning" v-on:click="doConfirmReload()">Có tin nhắn mới. Tải lại</div>

                <div class="p-m bg-white border-bottom border-top" v-on:scroll="scroll($event)" style="box-shadow: -1px 0 1px rgba(0,0,0,0.5); height: calc(100vh - 160px); overflow: auto">
                    <div class="m-t-md unread-lst lst-2428">
                        <div v-if="loading" style="text-align: center">Đang tải....</div>
                        <div v-else-if="visi()===0" style="text-align: center">Trống</div>
                        <div v-if="!loading">
                            <div class="item ix ix20 mb-2" v-on:click="readed($event,x.ID, x)" v-bind:readed="x.IsReaded" v-for="x in notiItems" v-if="visi(x)" style="padding-top: 30px; display: block;">
                                <div><b class=""><i class="hot-fa fa fa-comment-o "></i>{{x.Title}}</b></div>
                                <div class="time" style="top: 10px" v-bind:title="datevn(x.CreateDate)">{{fromNow(x.CreateDate)}}</div>
                                <div class="body">{{x.Body}}</div>
                                <div v-if="x.IsActed" style="margin: 1rem 0">
                                    <small class="text-muted">Đã phản hồi</small>
                                </div>
                                <div class="unread-btns">
                                    <span class="btn btn-xs btn-default readed mr-1" v-on:click.stop="clear($event, x.ID)">Xóa</span>
                                    <span class="btn btn-xs btn-default  mr-1" v-if="x.book" v-bind:acted="x.IsActed" v-bind:title="x.IsActed ? 'Đã phản hồi':'Chưa phản hồi'" v-on:click.stop="replyNoty(x,true)">Xác nhận</span>
                                    <span class="btn btn-xs btn-default" v-if="x.book" v-bind:acted="x.IsActed" v-bind:title="x.IsActed ? 'Đã phản hồi':'Chưa phản hồi'" v-on:click="replyNoty(x)">Hủy</span>

                                    <span class="btn btn-xs btn-default  mr-1" v-if="x.newbook" v-bind:acted="x.IsActed" v-bind:title="x.IsActed ? 'Đã phản hồi':'Chưa phản hồi'" v-on:click.stop="replyBookNew(x,true)">Xác nhận</span>
                                    <span class="btn btn-xs btn-default  mr-1" v-if="x.newbook" v-bind:acted="x.IsActed" v-bind:title="x.IsActed ? 'Đã phản hồi':'Chưa phản hồi'" v-on:click.stop="replyBookNew(x)">Hủy</span>
                                </div>

                            </div>
                        </div>
                        <div v-if="showMore && lastCount" style="text-align: center; padding: 15px 0">Đang tải thêm....</div>
                        <div v-if="lastCount === 0 && notiItems.length> 0 && notiItems.length< MAX" style="text-align: center; padding: 15px 0">--Hết--</div>
                    </div>
                </div>
                <div class="p-m">
                    <!--<button type="button" class="btn w-xs btn-info btn-xs btn-unread-readall" v-on:click="readed($event)">Đã đọc tất cả</button>-->
                    <a class="btn w-xs btn-link btn-xs btn-unread-delete " v-on:click="clear($event)">Xóa tất</a>
                    <a class="btn w-xs btn-link btn-xs btn-unread-delete " v-on:click="reload($event)">Làm mới</a>
                </div>
            </div>
        </div>




        <!-- Right Task -->
