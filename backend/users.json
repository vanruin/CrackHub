            var subItem = [];
            var firstUrl = '';
            var index = 0;
            for (var z in SideMenu[k]) {
                var v = SideMenu[k][z];
                if (z.startsWith('$')) {
                    switch (z) {
                        case '$ico':
                            //console.log('icon', v);
                            //sub.before(`<span class="label label-success pull-right label-nav"><i class="${v}"></i></span>`)
                            li.find('.nav-label').prepend(`<span class="w-5 h-5 flex items-center justify-center text-[20px] mr-3"><i class="w-5 h-5 ${v}"></i></span>`)
                            break;
                    }
                    continue;
                }

                var href = typeof v == 'string' ? v : v.href;
                var _index = typeof v == 'object' && typeof v['$index'] === 'number' ? v['$index'] : -1;
                var subLi = $(`<li><a href="${href}">${z}</a></li>`);

                if (firstUrl == '') firstUrl = href;

                subItem.push({
                    $el: subLi,
                    index: _index > -1 ? _index : index,
                    _index: _index
                })
                index++;
            }
            //console.log(k);
            //console.log(subItem);

            subItem.sort((a, b) => a.index - b.index);
            li.attr('data-first', firstUrl)
            if (subItem.length == 1 && firstUrl) {
                sub.remove();
                li.find('.fa.arrow').remove();
                li.on('click', function () {
                    window.location = li.attr('data-first');
                });
                li.find('a').attr('href', firstUrl);
            }

            subItem.forEach(z => {
                sub.append(z.$el);
            })
        }
    })

