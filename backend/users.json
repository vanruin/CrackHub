        GlobalConfig.getPath = (path, fn) => {
            //path start with '$.';
            var p = path.startsWith('$.') ? path.substr(2) : path;
            var segs = p.split('.');
            var exist = true;
            var o = GlobalConfig;
            for (var i = 0; i < segs.length; i++) {
                o = o[segs[i]];
                if (!o) {
                    if (i < segs.length - 1) exist = false;
                    break;
                }
            }
            if (exist) return fn(o);
            return false;
        }
        function isAdminTools() {
            var pass = false;
            if (window.Info) {
                Info.rightTree.groups.every(gr => {
                    if (gr.group == "Chức năng khác") {
                        //console.log(gr.group, gr.rights);
                        gr.rights.every(r => {
                            if (r.name == "adminTools") {
                                // console.log(r.name);
                                r.subs.every(s => {
                                    if (s.name == "adminTools_byStock") {
                                        //console.log(s.name);
                                        pass = s.hasRight || false;
                                    }
                                    return pass == false;
                                })
                            }
                            return pass == false;
                        })
                    }
                    return pass === false;
                });
                if (pass) return true;
            }
            return pass
        }
        var UploadAllowsExt = '.jpeg,.jpg,.gif,.png,.pdf,.doc,.docx,.xls,.xlsx,.txt,.rar,.zip,.7zip,.tiff,.exif,.bmp,.wmf';

        GlobalConfig.getPath('$.UploadAllowsExt', v => {
            UploadAllowsExt = v;
        })

    </script>
