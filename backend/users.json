            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        /* --- TÙY CHỈNH NÚT BÊN CỘT PHẢI (ICON TRÊN / TEXT DƯỚI) --- */
        .col-right .card-body {
            display: grid;
