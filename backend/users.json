        }

        .dashboard-container {
            max-width: 1140px;
            margin: 0 auto;
            display: flex;
            gap: 25px;
        }

        /* Cột trái (Cài đặt) */
        .col-left {
            width: 320px;
            flex-shrink: 0;
        }

        /* Cột phải (Chứa các phần còn lại) */
